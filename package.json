{
  "name": "website",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "dev:api": "tsx scripts/dev-api.ts",
    "dev:test": "ATTR_TEST=1 vite --port 5173 --strictPort",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "typecheck:harness": "tsc -p tsconfig.harness.json && tsc -p tsconfig.client-tests.json && tsc -p tsconfig.e2e.json",
    "test:e2e": "playwright test",
    "report:attr": "tsx scripts/attribution-report.ts",
    "report:ga4": "tsx scripts/ga4-report.ts",
    "recon:payments": "tsx scripts/reconcile-payments.ts"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-label": "^2.1.8",
    "@sparticuz/chromium": "^153.0.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "facebook-nodejs-business-sdk": "^24.0.1",
    "framer-motion": "^12.38.0",
    "google-auth-library": "^10.6.2",
    "google-spreadsheet": "^5.2.0",
    "googleapis": "^171.4.0",
    "lucide-react": "^0.577.0",
    "puppeteer-core": "^25.14.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "resend": "^6.9.3",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@tailwindcss/vite": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vercel/node": "^5",
    "@vitejs/plugin-react": "^4",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4",
    "tsx": "4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vite": "^6"
  }
}
