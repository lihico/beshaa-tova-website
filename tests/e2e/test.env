# Test mode for scripts/dev-api.ts (docs/attribution/00_DESIGN.md section 6.2).
# Every value is a dummy. Never add a real key here; dev-api refuses to start if production
# variables are present. This file is loaded instead of .env.local, which is never read.
ATTR_TEST=1
STORE_MODE=file
ATTR_DATA_DIR=.test-data
TOUCH_LOG=file
PAYMENTS_ENABLED=1
# The 2.11.2026 prices (349/410, express +50, codes 5%). Playwright passes the same flag to Vite.
NEW_PRICES=1
# Preferred provider: per-order Grow links through the (fake) Make scenario; fallback: fixed pages.
PAYMENT_PROVIDER=grow_make
GROW_MAKE_CREATE_URL=http://127.0.0.1:3001/_mock/grow/make/create
GROW_MAKE_SECRET=test-make-secret-0123456789
GROW_MAKE_TIMEOUT_MS=1500
# Fixed Grow pages on the fake Grow. The friend-code amounts (314, 364, 369, 419) are left out on
# purpose: an amount without a page must fall back to the WhatsApp flow.
GROW_PAGE_URLS='{"332":"http://127.0.0.1:3001/_mock/grow/page/332","349":"http://127.0.0.1:3001/_mock/grow/page/349","382":"http://127.0.0.1:3001/_mock/grow/page/382","390":"http://127.0.0.1:3001/_mock/grow/page/390","399":"http://127.0.0.1:3001/_mock/grow/page/399","410":"http://127.0.0.1:3001/_mock/grow/page/410","440":"http://127.0.0.1:3001/_mock/grow/page/440","460":"http://127.0.0.1:3001/_mock/grow/page/460"}'
MOCK_GROW_BASE=http://127.0.0.1:3001/_mock/grow/api/light/server/1.0
GROW_NOTIFY_SECRET=0123456789abcdef0123456789abcdef
PUBLIC_BASE_URL=http://localhost:5173
NOTIFY_BASE_URL=http://localhost:3001
COOKIE_DOMAIN=
RESEND_API_KEY=re_test_dummy
RESEND_BASE_URL=http://localhost:3001/_mock/resend
ORDER_NOTIFICATION_EMAIL=lihi-test@example.test
CAPI_MODE=log
META_PIXEL_ID=000000000000000
GA4_MEASUREMENT_ID=G-TEST000000
GA4_API_SECRET=
GIFT_RELEASE_SECRET=test-gift-secret
MARK_PAID_SECRET=test-mark-paid-secret
FULFIL_GIFT_RELEASE=log
AFFILIATE_PROVIDER=stub
